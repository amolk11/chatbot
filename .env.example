# ==============================================================================
# AI Chatbot Environment Configuration Template (.env.example)
# Copy this file to .env and fill in the values for your environment.
# DO NOT COMMIT THE REAL .env FILE TO VERSION CONTROL!
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
APP_NAME="AI Chatbot"
APP_VERSION=0.1.0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=console

# API Configuration
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]
RATE_LIMIT_PER_MINUTE=60

# LLM Gateway Settings (Phase 3)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-llm-api-key-here

# Persistence Settings (Phase 4)
DATABASE_URL=sqlite+aiosqlite:///./chatbot.db
CHAT_HISTORY_MAX_MESSAGES=50

# Caching Settings (Future Phase 5)
REDIS_URL=redis://localhost:6379/0

# Observability & LangSmith Settings (Future Phase 6)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=chatbot-dev
